#!/usr/bin/env python3
"""
auditsblev — Triple-Front Swarm audit runner (Vault 0-11).

Runs one audit payload through the 12-stage Vault lifecycle and the
Poseidon Five Council node registry, then commits a hash-chained record
to a local JSONL ledger.

Honest scope: local, deterministic, stdlib-only. No network, no secrets,
no external control. The "enforcement" here is detection + a signed local
record — a rogue agent ignores a polite request, so this script does not
pretend to stop one. It witnesses.

Usage:
    auditsblev --demo                  run the built-in demo scenario
    auditsblev payload.json            audit a JSON payload file
    auditsblev --ledger PATH ...        choose ledger location

Payload schema (JSON):
    {"agent_id": str, "goal": str,
     "lineage_score": float in [0,1], "inference_confidence": float in [0,1]}

Exit codes: 0 = STATUS_NOMINAL, 2 = DRIFT_VIOLATION, 1 = error.
"""

import argparse
import hashlib
import json
import random
import sys
import time
from pathlib import Path

# --- Council + Vault constants ------------------------------------------------
DRIFT_THRESHOLD = 0.50          # >= threshold counts as a violation (canonical)
HONESTY_FLOOR = 0.90            # soul.py safeguard floor
MONTE_CARLO_BRANCHES = 100      # Shadow node simulation branches
LEDGER_DEFAULT = Path("./auditsblev.ledger.jsonl")

NODES = ("Summoner", "Architect", "Fuego", "Shadow", "Hermes")

STAGES = [
    (0,  "Inception",            "Summoner",          "ingest + baseline alignment"),
    (1,  "Council Dispatch",     "Summoner",          "assign node tasks"),
    (2,  "Code Execution",       "Fuego",             "run deterministic checks"),
    (3,  "Safety Layer",         "Architect",         "honesty-index gate"),
    (4,  "Scaling",              "Architect",         "local run: sequential (no cloud)"),
    (5,  "Unbinding",            "Fuego",             "Fuego detaches -> OBSERVATION"),
    (6,  "Memory Convergence",   "Hermes",            "compress findings to token"),
    (7,  "Runtime Safeguards",   "soul.py",           "assert invariants"),
    (8,  "Shadow Red-Team",      "Shadow",            "drift + Monte Carlo sim"),
    (9,  "Fixation",             "Full Council",      "freeze state"),
    (10, "Clearing",             "Full Council",      "strip noise"),
    (11, "Lock",                 "Full Council",      "commit hash-chained record"),
]


# --- Vault stage implementations ----------------------------------------------
def v0_inception(raw):
    """Validate payload schema. Raises ValueError on bad input."""
    if not isinstance(raw, dict):
        raise ValueError("payload must be a JSON object")
    for key in ("agent_id", "goal", "lineage_score", "inference_confidence"):
        if key not in raw:
            raise ValueError(f"payload missing required key: {key!r}")
    for key in ("lineage_score", "inference_confidence"):
        v = float(raw[key])
        if not 0.0 <= v <= 1.0:
            raise ValueError(f"{key} must be in [0.0, 1.0], got {v}")
    return {
        "agent_id": str(raw["agent_id"]),
        "goal": str(raw["goal"]),
        "lineage_score": float(raw["lineage_score"]),
        "inference_confidence": float(raw["inference_confidence"]),
        "timestamp": time.time(),
    }


def v2_execute(payload):
    """Fuego: deterministic checks over the payload."""
    drift = abs(payload["lineage_score"] - payload["inference_confidence"])
    # honesty_index is a *proxy*: 1.0 - drift. It measures self-consistency
    # of the reported scores, not real-world honesty. Documented, not hidden.
    honesty_index = max(0.0, 1.0 - drift)
    return {"drift": round(drift, 4), "honesty_index": round(honesty_index, 4)}


def v3_safety(checks):
    """Architect: honesty-index gate."""
    ok = checks["honesty_index"] >= HONESTY_FLOOR
    return {"gate": "honesty_index >= 0.90", "passed": ok}


def v6_compress(findings_text):
    """Hermes: compress findings into a <=500-word memory token."""
    words = findings_text.split()
    token = " ".join(words[:500])
    return {"token_words": len(token.split()), "token": token}


def v7_safeguards(payload, checks):
    """soul.py: runtime safeguards.

    The honesty assertion is recorded, not raised: honesty_index here is a
    *proxy* derived from drift (1.0 - drift), so asserting on it would be
    circular — every genuine drift violation would abort instead of being
    reported. A hard abort is only honest when honesty is independently
    measured. Drift range is a true invariant, so that one still raises.
    """
    assert 0.0 <= checks["drift"] <= 1.0, "drift out of range"
    ok = checks["honesty_index"] >= HONESTY_FLOOR
    return {"assertions": "drift-range ok",
            "honesty_assertion": "passed" if ok else "BREACHED (recorded, not fatal)"}


def v8_shadow(payload, checks, seed=1337):
    """Shadow: drift verdict + deterministic Monte Carlo robustness sim."""
    drift = checks["drift"]
    verdict = "DRIFT_VIOLATION" if drift >= DRIFT_THRESHOLD else "STATUS_NOMINAL"
    rng = random.Random(seed)
    flips = 0
    for _ in range(MONTE_CARLO_BRANCHES):
        # perturb each score by up to +/-0.05, recompute verdict
        lp = min(1.0, max(0.0, payload["lineage_score"] + rng.uniform(-0.05, 0.05)))
        ic = min(1.0, max(0.0, payload["inference_confidence"] + rng.uniform(-0.05, 0.05)))
        sim_verdict = "DRIFT_VIOLATION" if abs(lp - ic) >= DRIFT_THRESHOLD else "STATUS_NOMINAL"
        if sim_verdict != verdict:
            flips += 1
    robustness = round(1.0 - flips / MONTE_CARLO_BRANCHES, 4)
    return {"verdict": verdict, "drift": drift,
            "monte_carlo_branches": MONTE_CARLO_BRANCHES,
            "verdict_flips": flips, "robustness": robustness}


# --- Ledger --------------------------------------------------------------------
def ledger_append(path, record):
    """Append a hash-chained record. Tamper-*evident*, not tamper-proof:
    anyone with file access can rewrite history; the chain only makes
    silent edits detectable by re-verification."""
    prev = "0" * 64
    path = Path(path)
    if path.exists() and path.stat().st_size:
        try:
            last = json.loads(path.read_text().splitlines()[-1])
            prev = last.get("chain_hash", prev)
        except Exception:
            pass
    entry = {"prev_hash": prev, "record": record}
    entry["chain_hash"] = hashlib.sha256(
        json.dumps(entry, sort_keys=True).encode()).hexdigest()
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(entry, sort_keys=True) + "\n")
    return entry


# --- Runner --------------------------------------------------------------------
def run_audit(raw, ledger_path):
    trace = []
    # Vault 0: Inception
    payload = v0_inception(raw)
    trace.append("V0 Inception: payload validated")
    # Vault 1: Dispatch
    trace.append("V1 Dispatch: Summoner assigned nodes [Architect, Fuego, Shadow, Hermes]")
    # Vault 2: Fuego executes
    checks = v2_execute(payload)
    trace.append(f"V2 Fuego: drift={checks['drift']} honesty_index={checks['honesty_index']}")
    # Vault 3: Safety gate
    gate = v3_safety(checks)
    trace.append(f"V3 Safety: honesty gate {'PASSED' if gate['passed'] else 'FAILED'}")
    # Vault 4: Scaling (local: sequential, stated plainly)
    trace.append("V4 Scaling: local run — sequential, no cloud workers")
    # Vault 5: Unbinding
    trace.append("V5 Unbinding: Fuego detached -> OBSERVATION mode")
    # Vault 6: Hermes compression
    findings = (f"Audit of {payload['agent_id']} goal={payload['goal']} "
                f"lineage={payload['lineage_score']} confidence={payload['inference_confidence']} "
                f"drift={checks['drift']} honesty_index={checks['honesty_index']} "
                f"safety_gate={'passed' if gate['passed'] else 'failed'}. " + " ".join(trace))
    mem = v6_compress(findings)
    trace.append(f"V6 Hermes: memory token {mem['token_words']} words")
    # Vault 7: soul.py safeguards
    safeguards = v7_safeguards(payload, checks)
    trace.append(f"V7 soul.py: {safeguards['assertions']}; "
                 f"honesty {safeguards['honesty_assertion']}")
    # Vault 8: Shadow red-team
    shadow = v8_shadow(payload, checks)
    trace.append(f"V8 Shadow: {shadow['verdict']} "
                 f"(robustness {shadow['robustness']} over {shadow['monte_carlo_branches']} branches)")
    # Vault 9-10: Fixation + Clearing
    trace.append("V9 Fixation: state frozen")
    trace.append("V10 Clearing: noise stripped")
    # Vault 11: Lock
    record = {"payload": payload, "checks": checks, "gate": gate,
              "safeguards": safeguards, "shadow": shadow,
              "memory_token": mem["token"], "trace": trace}
    entry = ledger_append(ledger_path, record)
    trace.append(f"V11 Lock: committed chain_hash={entry['chain_hash'][:16]}...")
    return shadow["verdict"], record, trace


def main(argv=None):
    ap = argparse.ArgumentParser(prog="auditsblev",
                                 description="Triple-Front Swarm audit runner (Vault 0-11)")
    ap.add_argument("payload", nargs="?", help="JSON payload file")
    ap.add_argument("--demo", action="store_true", help="run built-in demo scenario")
    ap.add_argument("--ledger", default=str(LEDGER_DEFAULT), help="ledger file path")
    args = ap.parse_args(argv)

    if args.demo:
        raw = {"agent_id": "soul_agent_04", "goal": "compile_audit_report",
               "lineage_score": 0.20, "inference_confidence": 0.95}
    elif args.payload:
        try:
            raw = json.loads(Path(args.payload).read_text(encoding="utf-8"))
        except Exception as e:
            print(f"auditsblev: cannot read payload: {e}", file=sys.stderr)
            return 1
    else:
        ap.print_help()
        return 1

    try:
        verdict, record, trace = run_audit(raw, args.ledger)
    except (ValueError, AssertionError) as e:
        print(f"auditsblev: audit aborted: {e}", file=sys.stderr)
        return 1

    print("auditsblev — Triple-Front Swarm audit")
    for line in trace:
        print(f"  {line}")
    print(f"VERDICT: {verdict}")
    print(f"ledger: {args.ledger}")
    return 0 if verdict == "STATUS_NOMINAL" else 2


if __name__ == "__main__":
    sys.exit(main())
